# Gemini API key for the Ask tab. Create one at https://aistudio.google.com/apikey
# — the free tier is enough for personal use (rate-limited per minute and per day,
# no card required). Same key/approach as the PERAI project.
#
# NOTE: EXPO_PUBLIC_* vars are inlined into the JS bundle at build time, so this
# key ships inside the installed app and is extractable from it. Acceptable for
# personal use; see README "Chatbot setup" for the alternative if not.
EXPO_PUBLIC_GEMINI_API_KEY=

# Optional model override. Default is set in src/ai/client.ts.
# EXPO_PUBLIC_GEMINI_ASK_MODEL=gemini-3.5-flash-lite
