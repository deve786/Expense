{
  "expo": {
    "name": "Spendly",
    "slug": "split",
    "scheme": "spendly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e8e8dedb-51a8-46e9-94ec-1aef3e416242",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ijasahmed.spendly"
    },
    "android": {
      "package": "com.ijasahmed.spendly",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-updates"
    ],
    "extra": {
      "chatProxyUrl": "",
      "chatAppToken": "",
      "eas": {
        "projectId": "e8e8dedb-51a8-46e9-94ec-1aef3e416242"
      }
    },
    "owner": "ijasahmed"
  }
}
